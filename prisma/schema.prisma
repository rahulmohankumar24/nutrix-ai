generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  profile      Profile?
  preferences  Preferences?
  dailyTargets DailyTarget[]
  mealLogs     MealLog[]
  reminders    Reminder[]
  restaurantContributions RestaurantContribution[]
  userPatterns UserPattern[]
  patternInsights PatternInsight[]
  pantryItems  PantryItem[]

  @@map("users")
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  sex           String
  age           Int?
  heightIn      Int
  weightLb      Int
  goal          String  // recomp | lean_bulk | cut
  liftingDays   Int
  stepsLevel    String  // low | med | high
  constraints   String  @default("[]") // JSON array of dietary constraints
  dislikes      String  @default("")
  wakeTime      String
  lunchTime     String
  dinnerTime    String
  isPro         Boolean @default(false) // Pro subscription status

  // Stripe subscription fields
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Preferences {
  id              String @id @default(cuid())
  userId          String @unique
  eatingPattern   String // mostly_eat_out | mostly_home | mixed
  dislikesDetected String @default("[]") // JSON array
  preferredCuisines String @default("[]") // JSON array
  timeToCook      String // none | 15min | 30min+
  budget          String? // low | medium | high
  coachingNotes   String @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model DailyTarget {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime
  calories Int
  protein  Int
  carbs    Int
  fat      Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_targets")
}

model FoodCatalogItem {
  id              String @id @default(cuid())
  name            String
  source          String // home | grocery | restaurant
  tags            String @default("[]") // JSON array
  calories        Int
  protein         Int
  carbs           Int
  fat             Int
  ingredientsText String?

  mealLogs MealLog[]

  @@map("food_catalog_items")
}

model OrderTemplate {
  id                        String @id @default(cuid())
  restaurantBrand           String
  title                     String
  description               String
  calories                  Int
  protein                   Int
  carbs                     Int
  fat                       Int
  tags                      String @default("[]") // JSON array
  keywordsForDeliverySearch String

  mealLogs MealLog[]

  @@map("order_templates")
}

model MealLog {
  id                 String   @id @default(cuid())
  userId             String
  datetime           DateTime @default(now())
  foodCatalogItemId  String?
  orderTemplateId    String?
  servings           Float    @default(1.0)
  mealType           String?  // breakfast, lunch, dinner, snack

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodCatalogItem  FoodCatalogItem?  @relation(fields: [foodCatalogItemId], references: [id])
  orderTemplate    OrderTemplate?    @relation(fields: [orderTemplateId], references: [id])

  @@map("meal_logs")
}

model Reminder {
  id        String  @id @default(cuid())
  userId    String
  name      String
  timeOfDay String  // HH:MM format
  enabled   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model RestaurantContribution {
  id               String   @id @default(cuid())
  userId           String
  restaurantName   String
  restaurantType   String?
  mealName         String
  calories         Int
  protein          Int
  carbs            Int?
  fat              Int?
  contributionType String   @default("user_input") // user_input, menu_photo, receipt_scan
  notes            String?
  confidence       String   @default("medium") // low, medium, high
  source           String   @default("user_reported") // user_reported, menu_verified, receipt_scanned
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  verifiedAt       DateTime?
  verifiedBy       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantName])
  @@index([verified])
  @@index([createdAt])
  @@map("restaurant_contributions")
}

model AiGeneratedMeal {
  id               String   @id @default(cuid())
  restaurantName   String
  title            String
  description      String
  calories         Int
  protein          Int
  carbs            Int
  fat              Int
  reasoning        String?
  source           String   @default("ai_estimated") // ai_estimated, ai_from_menu, user_verified
  estimatedNutrition Boolean @default(true)
  tags             String   @default("[]") // JSON array
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Aggregated feedback stats
  feedbackCount    Int      @default(0)
  avgCaloriesAdjustment Int  @default(0) // Average adjustment from feedback
  avgProteinAdjustment  Int  @default(0)
  avgCarbsAdjustment    Int  @default(0)
  avgFatAdjustment      Int  @default(0)
  confidenceScore  Float    @default(0.5) // 0-1, increases with positive feedback

  feedback MealFeedback[]

  @@index([restaurantName])
  @@index([confidenceScore])
  @@map("ai_generated_meals")
}

model MealFeedback {
  id                String   @id @default(cuid())
  userId            String
  aiGeneratedMealId String

  // User's correction/feedback
  suggestedCalories Int?
  suggestedProtein  Int?
  suggestedCarbs    Int?
  suggestedFat      Int?

  feedbackType      String   // accurate | too_high | too_low | missing_item
  comment           String?
  helpful           Boolean  @default(true)
  createdAt         DateTime @default(now())

  aiGeneratedMeal AiGeneratedMeal @relation(fields: [aiGeneratedMealId], references: [id], onDelete: Cascade)

  @@index([aiGeneratedMealId])
  @@index([createdAt])
  @@map("meal_feedback")
}

// Personal Pattern Learning System
model UserPattern {
  id            String   @id @default(cuid())
  userId        String
  patternType   String   // timing | restaurant | success | recovery
  patternKey    String   // e.g., "weekday_breakfast", "chipotle_frequency"
  patternValue  Json     // Flexible JSON for pattern-specific data
  confidence    Float    @default(0.5) // 0-1, how confident we are in this pattern
  occurrences   Int      @default(1)   // How many data points support this pattern
  lastUpdated   DateTime @updatedAt
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, patternType, patternKey])
  @@index([userId])
  @@index([userId, patternType])
  @@map("user_patterns")
}

model PatternInsight {
  id             String    @id @default(cuid())
  userId         String
  category       String    // timing | restaurant | success | recovery
  headline       String    // Short observation: "Your Monday game is strong"
  body           String    // Longer explanation
  tone           String    // positive | neutral | curious
  confidence     Float     @default(0.5)
  relevanceScore Float     @default(0.5) // How relevant this insight is today
  patternIds     String    @default("[]") // JSON array of pattern IDs that generated this
  displayedCount Int       @default(0)
  lastDisplayed  DateTime?
  expiresAt      DateTime? // Optional expiration for time-sensitive insights
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, category])
  @@map("pattern_insights")
}

// Waitlist for early access signups
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist")
}

// Weekly Insight Cache - stores AI-generated weekly summaries
model WeeklyInsightCache {
  id           String   @id @default(cuid())
  userId       String
  weekStartDate String  // YYYY-MM-DD format for the Monday of the week
  summary      String   // AI-generated summary
  daysData     String   // JSON string of days array
  generatedAt  DateTime @default(now())

  @@unique([userId, weekStartDate])
  @@index([userId])
  @@map("weekly_insight_cache")
}

// Pantry/Inventory System
model PantryItem {
  id           String    @id @default(cuid())
  userId       String
  name         String
  category     String    // protein | carb | vegetable | fruit | dairy | snack | condiment | other
  quantity     String?   // "2 lbs", "1 bag", "6 pack", etc.
  calories     Int?      // per serving, if known
  protein      Int?
  carbs        Int?
  fat          Int?
  servingSize  String?   // "1 cup", "100g", etc.
  expiresAt    DateTime? // Optional expiration date
  source       String    @default("manual") // manual | receipt_scan | barcode
  isStaple     Boolean   @default(false) // Items that are always restocked
  inStock      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@index([userId, inStock])
  @@map("pantry_items")
}
